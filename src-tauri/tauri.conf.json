{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Pico",
  "version": "../package.json",
  "identifier": "com.varalikaagarwal.pico",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Pico",
        "width": 1050,
        "height": 660,
        "minWidth": 900,
        "minHeight": 500,
        "center": true,
        "decorations": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; script-src 'self'; connect-src 'self' ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "app",
      "dmg"
    ],
    "resources": {
      "resources/adb": "adb",
      "../LICENSE": "LICENSE",
      "../THIRD_PARTY_NOTICES.md": "THIRD_PARTY_NOTICES.md"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns"
    ],
    "createUpdaterArtifacts": true,
    "macOS": {
      "signingIdentity": "-",
      "minimumSystemVersion": "11.0",
      "files": {
        "Resources/Assets.car": "icons/Assets.car"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IDE4ODdDNkRFQTAwRDExRjUKUldUMUVRMmczc2FIR0V2TmIwMUMzYVNacTgrbzNYdHpvc0VLTHdTNzVYK1FEaVNlNS8zZVUwV0IK",
      "endpoints": [
        "https://github.com/A3In1/Pico/releases/latest/download/latest.json"
      ]
    }
  }
}
